# ==========================================
# Alexandria Stock Management Environment
# ==========================================

# 1. Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockmgmt
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockmgmt

# 2. Redis
REDIS_URL=redis://localhost:6379/0

# 3. Backend API (Next.js 서버가 FastAPI로 프록시할 주소)
BACKEND_API_URL=http://localhost:8000/api/v1

# 4. 한국투자증권 (KIS Developers) Open API
# https://apiportal.koreainvestment.com 에서 무료 발급 가능 (1회 등록 시 24시간 토큰 자동 갱신)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=           # 계좌번호 앞 8자리
KIS_ACNT_PRDT_CD=01 # 계좌번호 뒤 2자리 (기본: 01)
KIS_IS_VIRTUAL=false # 모의투자 여부 (실전투자: false, 모의투자: true)

# 5. Google Sheets (Optional Legacy / Backup)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
