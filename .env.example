# ==========================================
# Alexandria Stock Management Environment
# ==========================================

# 1. Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockmgmt
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockmgmt

# 2. Redis
REDIS_URL=redis://localhost:6379/0

# 3. Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# 4. Google Sheets (Optional Legacy / Backup)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
